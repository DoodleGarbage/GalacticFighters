; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Galactic Fighters Prototype"
config/description="This is the digital version of the card game Galactic Fighters."
run/main_scene="uid://dpt64c3xv2lsh"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
boot_splash/stretch_mode=3
boot_splash/image="uid://xcwhomf3qbof"
config/icon="uid://ccmumpj1wk5d5"
boot_splash/minimum_display_time=3000

[autoload]

Resources="*uid://dingxo658ftmu"

[debug]

gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://Art/": "yellow",
"res://Data/": "purple",
"res://GUI/": "green",
"res://Gameplay/": "red",
"res://ParticleEffects/": "yellow",
"res://Resources/": "purple",
"res://Themes/": "yellow"
}

